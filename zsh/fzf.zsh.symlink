# fzf shell integration (zsh)
# ---------------------------
# fzf >= 0.48 ships its shell integration inside the binary, so there is no
# submodule or checkout to source. Guard on availability: this file is a no-op
# when fzf is not installed.
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi
